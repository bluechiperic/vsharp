<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Produced by build/fetch-z3.sh. Not on nuget.org. -->
    <add key="vsharp-z3" value="./build/nugets" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="vsharp-z3">
      <package pattern="VSharp.Z3" />
    </packageSource>
  </packageSourceMapping>
</configuration>
